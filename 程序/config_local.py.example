# config_local.py.example
# 本地配置文件示例
# 
# 使用方法：
# 1. 复制此文件为 config_local.py
# 2. 在 config_local.py 中填入您的实际API Key和应用ID
# 3. config_local.py 已在 .gitignore 中，不会被提交到版本控制

# 阿里云百炼 API Key（必填）
# 在阿里云DashScope控制台获取：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY = "YOUR_DASHSCOPE_API_KEY_HERE"

# 智能体应用 ID（必填）
# 在阿里云百炼应用管理页面创建智能体应用后获取：https://bailian.console.aliyun.com/
# 在应用卡片上复制 APP_ID
APP_ID = "YOUR_APP_ID_HERE"

# API ID（可选，用于标识）
API_ID = "YOUR_API_ID_HERE"

